# --- LLM: xAI Grok (OpenAI-compatible API). Leave GROK_API_KEY empty for heuristic mode. ---
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1
# auto = use Grok when a key is set; heuristic = force offline rule-based extraction
LLM_MODE=auto

# --- Web search provider: tavily | brave | none ---
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# --- Runtime ---
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080
MAX_SOURCE_COUNT=10
MAX_PDF_SIZE_MB=15
REQUEST_TIMEOUT_SECONDS=15
